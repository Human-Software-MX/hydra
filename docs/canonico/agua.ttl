cal:bill_line_bill_id a owl:ObjectProperty ; rdfs:domain cal:BillLine ; rdfs:range cal:Bill ; rdfs:label "bill_id"@es ; rdfs:comment "requerido"@es .
cal:bill_line_concept_code a owl:DatatypeProperty ; rdfs:domain cal:BillLine ; rdfs:range xsd:string ; rdfs:label "concept_code"@es ; rdfs:comment "requerido · aka ConceptoCobro.codigo"@es .
cal:bill_line_description a owl:DatatypeProperty ; rdfs:domain cal:BillLine ; rdfs:range xsd:string ; rdfs:label "description"@es ; rdfs:comment "aka nombre"@es .
cal:bill_line_quantity a owl:DatatypeProperty ; rdfs:domain cal:BillLine ; rdfs:range xsd:decimal ; rdfs:label "quantity"@es ; rdfs:comment "aka cantidad"@es .
cal:bill_line_unit_price a owl:DatatypeProperty ; rdfs:domain cal:BillLine ; rdfs:range xsd:decimal ; rdfs:label "unit_price"@es ; rdfs:comment "aka precioBase/precioProporcional"@es .
cal:bill_line_amount a owl:DatatypeProperty ; rdfs:domain cal:BillLine ; rdfs:range xsd:decimal ; rdfs:label "amount"@es ; rdfs:comment "requerido · aka importe"@es .
cal:bill_line_vat_pct a owl:DatatypeProperty ; rdfs:domain cal:BillLine ; rdfs:range xsd:decimal ; rdfs:label "vat_pct"@es ; rdfs:comment "aka ivaPct"@es .
cal:bill_line_vat_amount a owl:DatatypeProperty ; rdfs:domain cal:BillLine ; rdfs:range xsd:decimal ; rdfs:label "vat_amount"@es ; rdfs:comment "aka ivaImporte"@es .
cal:bill_line_order a owl:DatatypeProperty ; rdfs:domain cal:BillLine ; rdfs:range xsd:integer ; rdfs:label "order"@es ; rdfs:comment "aka orden"@es .

### Clase payment
cal:Payment a owl:Class ; rdfs:label "Payment"@es ; rdfs:comment "Applied payment from any channel (aka Pago; external-collector records — PagoExterno staging over the ~22 recaudador layouts — become payments on conciliation). Rule: paid_at is the real client payment date from the collector file, not the file-arrival date."@es ; skos:note "clave: id"@es .
cal:payment_id a owl:DatatypeProperty ; rdfs:domain cal:Payment ; rdfs:range xsd:string ; rdfs:label "id"@es ; rdfs:comment "requerido"@es .
cal:payment_agreement_id a owl:ObjectProperty ; rdfs:domain cal:Payment ; rdfs:range cal:ServiceAgreement ; rdfs:label "agreement_id"@es ; rdfs:comment "requerido"@es .
cal:payment_bill_id a owl:ObjectProperty ; rdfs:domain cal:Payment ; rdfs:range cal:Bill ; rdfs:label "bill_id"@es ; rdfs:comment "aka reciboId/timbradoId"@es .
cal:payment_payment_agreement_id a owl:ObjectProperty ; rdfs:domain cal:Payment ; rdfs:range cal:PaymentAgreement ; rdfs:label "payment_agreement_id"@es ; rdfs:comment "aka convenioId"@es .
cal:payment_amount a owl:DatatypeProperty ; rdfs:domain cal:Payment ; rdfs:range xsd:decimal ; rdfs:label "amount"@es ; rdfs:comment "requerido · aka monto; collector files may carry cents or split IMPORTE+IMPORTE DEC — mappings normalize to decimal MXN"@es .
cal:payment_currency a owl:DatatypeProperty ; rdfs:domain cal:Payment ; rdfs:range xsd:string ; rdfs:label "currency"@es ; rdfs:comment "MXN default"@es .
cal:payment_paid_at a owl:DatatypeProperty ; rdfs:domain cal:Payment ; rdfs:range xsd:dateTime ; rdfs:label "paid_at"@es ; rdfs:comment "requerido · Real payment date; aka fechaPagoReal, FECHA in collector layouts (formats vary)"@es .
cal:payment_channel a owl:DatatypeProperty ; rdfs:domain cal:Payment ; rdfs:range xsd:string ; rdfs:label "channel"@es ; rdfs:comment "valores: cashier, portal, direct_debit, external_collector, codi, other · aka origen nativo/externo + canal"@es .
cal:payment_method a owl:DatatypeProperty ; rdfs:domain cal:Payment ; rdfs:range xsd:string ; rdfs:label "method"@es ; rdfs:comment "valores: cash, card, transfer, check, direct_debit, other · aka FormaPago/SAT code via DIF. FORMAS DE PAGO mapping"@es .
cal:payment_collector a owl:DatatypeProperty ; rdfs:domain cal:Payment ; rdfs:range xsd:string ; rdfs:label "collector"@es ; rdfs:comment "Recaudador (OXXO, BANORTE, BBVA...); aka recaudador + emisora code"@es .
cal:payment_external_reference a owl:DatatypeProperty ; rdfs:domain cal:Payment ; rdfs:range xsd:string ; rdfs:label "external_reference"@es ; rdfs:comment "Collector reference/folio; aka referencia"@es .
cal:payment_office a owl:DatatypeProperty ; rdfs:domain cal:Payment ; rdfs:range xsd:string ; rdfs:label "office"@es ; rdfs:comment "Branch/cashier office; aka oficina/sucursal"@es .
cal:payment_conciliation_status a owl:DatatypeProperty ; rdfs:domain cal:Payment ; rdfs:range xsd:string ; rdfs:label "conciliation_status"@es ; rdfs:comment "valores: applied, pending_conciliation, conciliated, rejected · aka estado pendiente_conciliar/conciliado/rechazado + motivoRechazo"@es .
cal:payment_raw_record a owl:DatatypeProperty ; rdfs:domain cal:Payment ; rdfs:range xsd:string ; rdfs:label "raw_record"@es ; rdfs:comment "Original collector record; aka datosRaw + contratoRaw"@es .

### Clase payment_agreement
cal:PaymentAgreement a owl:Class ; rdfs:label "Payment agreement (convenio)"@es ; rdfs:comment "Debt installment plan (aka Convenio de parcialidades; REP 2.0 CFDI complement applies to installment payments)."@es ; skos:note "clave: id"@es .
cal:payment_agreement_id a owl:DatatypeProperty ; rdfs:domain cal:PaymentAgreement ; rdfs:range xsd:string ; rdfs:label "id"@es ; rdfs:comment "requerido"@es .
cal:payment_agreement_agreement_id a owl:ObjectProperty ; rdfs:domain cal:PaymentAgreement ; rdfs:range cal:ServiceAgreement ; rdfs:label "agreement_id"@es ; rdfs:comment "requerido"@es .
cal:payment_agreement_origin a owl:DatatypeProperty ; rdfs:domain cal:PaymentAgreement ; rdfs:range xsd:string ; rdfs:label "origin"@es ; rdfs:comment "valores: overdue_debt, cut, reconnection, other · aka origenTipo"@es .
cal:payment_agreement_installments a owl:DatatypeProperty ; rdfs:domain cal:PaymentAgreement ; rdfs:range xsd:integer ; rdfs:label "installments"@es ; rdfs:comment "requerido · aka numParcialidades"@es .
cal:payment_agreement_installment_amount a owl:DatatypeProperty ; rdfs:domain cal:PaymentAgreement ; rdfs:range xsd:decimal ; rdfs:label "installment_amount"@es ; rdfs:comment "requerido · aka montoParcialidad"@es .
cal:payment_agreement_total_amount a owl:DatatypeProperty ; rdfs:domain cal:PaymentAgreement ; rdfs:range xsd:decimal ; rdfs:label "total_amount"@es ; rdfs:comment "requerido · aka montoTotal"@es .
cal:payment_agreement_paid_amount a owl:DatatypeProperty ; rdfs:domain cal:PaymentAgreement ; rdfs:range xsd:decimal ; rdfs:label "paid_amount"@es ; rdfs:comment "aka montoPagado"@es .
cal:payment_agreement_down_payment a owl:DatatypeProperty ; rdfs:domain cal:PaymentAgreement ; rdfs:range xsd:decimal ; rdfs:label "down_payment"@es ; rdfs:comment "aka montoAnticipo/porcentajeAnticipo"@es .
cal:payment_agreement_covered_bill_ids a owl:DatatypeProperty ; rdfs:domain cal:PaymentAgreement ; rdfs:range xsd:string ; rdfs:label "covered_bill_ids"@es ; rdfs:comment "Bills under the plan; aka facturas (JSONB in Hydra — relational here)"@es .
cal:payment_agreement_credit_balance a owl:DatatypeProperty ; rdfs:domain cal:PaymentAgreement ; rdfs:range xsd:decimal ; rdfs:label "credit_balance"@es ; rdfs:comment "aka saldoAFavor"@es .
cal:payment_agreement_status a owl:DatatypeProperty ; rdfs:domain cal:PaymentAgreement ; rdfs:range xsd:string ; rdfs:label "status"@es ; rdfs:comment "valores: active, completed, defaulted, canceled · aka estado"@es .
cal:payment_agreement_start_date a owl:DatatypeProperty ; rdfs:domain cal:PaymentAgreement ; rdfs:range xsd:date ; rdfs:label "start_date"@es ; rdfs:comment "aka fechaInicio"@es .
cal:payment_agreement_due_date a owl:DatatypeProperty ; rdfs:domain cal:PaymentAgreement ; rdfs:range xsd:date ; rdfs:label "due_date"@es ; rdfs:comment "aka fechaVencimiento"@es .

### Clase work_order
cal:WorkOrder a owl:Class ; rdfs:label "Work order"@es ; rdfs:comment "Field order: cut/restriction, reconnection, installation, inspection, review (aka Orden, orden de trabajo, Q Order). cut_impact encodes the minimum-vital rule of the Ley General de Aguas 2025: domestic service is restricted, never fully suspended."@es ; skos:note "clave: id"@es .
cal:work_order_id a owl:DatatypeProperty ; rdfs:domain cal:WorkOrder ; rdfs:range xsd:string ; rdfs:label "id"@es ; rdfs:comment "requerido"@es .
cal:work_order_agreement_id a owl:ObjectProperty ; rdfs:domain cal:WorkOrder ; rdfs:range cal:ServiceAgreement ; rdfs:label "agreement_id"@es ; rdfs:comment "requerido"@es .
cal:work_order_type a owl:DatatypeProperty ; rdfs:domain cal:WorkOrder ; rdfs:range xsd:string ; rdfs:label "type"@es ; rdfs:comment "valores: cut, reconnection, installation, inspection, review, other · aka tipo"@es .
cal:work_order_cut_impact a owl:DatatypeProperty ; rdfs:domain cal:WorkOrder ; rdfs:range xsd:string ; rdfs:label "cut_impact"@es ; rdfs:comment "valores: total_suspension, partial_restriction, record_only · aka CatalogoTipoCorte.impacto; domestic use → partial_restriction only"@es .
cal:work_order_cut_location a owl:DatatypeProperty ; rdfs:domain cal:WorkOrder ; rdfs:range xsd:string ; rdfs:label "cut_location"@es ; rdfs:comment "valores: meter_box, connection, sidewalk_valve · aka ubicacionCorte cuadro/toma/llave_banqueta"@es .
cal:work_order_status a owl:DatatypeProperty ; rdfs:domain cal:WorkOrder ; rdfs:range xsd:string ; rdfs:label "status"@es ; rdfs:comment "valores: pending, scheduled, executed, canceled · aka estado"@es .
cal:work_order_priority a owl:DatatypeProperty ; rdfs:domain cal:WorkOrder ; rdfs:range xsd:string ; rdfs:label "priority"@es ; rdfs:comment "aka prioridad"@es .
cal:work_order_auto_generated a owl:DatatypeProperty ; rdfs:domain cal:WorkOrder ; rdfs:range xsd:boolean ; rdfs:label "auto_generated"@es ; rdfs:comment "aka origenAutomatico/eventoOrigen"@es .
cal:work_order_requested_at a owl:DatatypeProperty ; rdfs:domain cal:WorkOrder ; rdfs:range xsd:dateTime ; rdfs:label "requested_at"@es ; rdfs:comment "aka fechaSolicitud"@es .
cal:work_order_scheduled_at a owl:DatatypeProperty ; rdfs:domain cal:WorkOrder ; rdfs:range xsd:dateTime ; rdfs:label "scheduled_at"@es ; rdfs:comment "aka fechaProgramada"@es .
cal:work_order_executed_at a owl:DatatypeProperty ; rdfs:domain cal:WorkOrder ; rdfs:range xsd:dateTime ; rdfs:label "executed_at"@es ; rdfs:comment "aka fechaEjecucion"@es .
cal:work_order_field_data a owl:DatatypeProperty ; rdfs:domain cal:WorkOrder ; rdfs:range xsd:string ; rdfs:label "field_data"@es ; rdfs:comment "Evidence, GPS, photos; aka datosCampo"@es .
cal:work_order_external_reference a owl:DatatypeProperty ; rdfs:domain cal:WorkOrder ; rdfs:range xsd:string ; rdfs:label "external_reference"@es ; rdfs:comment "aka externalRef (Q Order)"@es .

### Clase service_application
cal:ServiceApplication a owl:Class ; rdfs:label "Service application"@es ; rdfs:comment "New-service application entering the contracting flow (aka Solicitud; factibilidad → inspección → cotización → contratación)."@es ; skos:note "clave: id"@es .
cal:service_application_id a owl:DatatypeProperty ; rdfs:domain cal:ServiceApplication ; rdfs:range xsd:string ; rdfs:label "id"@es ; rdfs:comment "requerido"@es .
cal:service_application_folio a owl:DatatypeProperty ; rdfs:domain cal:ServiceApplication ; rdfs:range xsd:string ; rdfs:label "folio"@es ; rdfs:comment "requerido"@es .
cal:service_application_applicant_name a owl:DatatypeProperty ; rdfs:domain cal:ServiceApplication ; rdfs:range xsd:string ; rdfs:label "applicant_name"@es ; rdfs:comment "aka propNombreCompleto"@es .
cal:service_application_applicant_tax_id a owl:DatatypeProperty ; rdfs:domain cal:ServiceApplication ; rdfs:range xsd:string ; rdfs:label "applicant_tax_id"@es ; rdfs:comment "aka propRfc"@es .
cal:service_application_cadastral_key a owl:DatatypeProperty ; rdfs:domain cal:ServiceApplication ; rdfs:range xsd:string ; rdfs:label "cadastral_key"@es ; rdfs:comment "aka claveCatastral"@es .
cal:service_application_service_class_id a owl:ObjectProperty ; rdfs:domain cal:ServiceApplication ; rdfs:range cal:ServiceClass ; rdfs:label "service_class_id"@es ; rdfs:comment "aka tipoContratacionId"@es .
cal:service_application_status a owl:DatatypeProperty ; rdfs:domain cal:ServiceApplication ; rdfs:range xsd:string ; rdfs:label "status"@es ; rdfs:comment "valores: pending_review, inspection_required, inspection_in_progress, quoting, accepted, contracted, rejected, canceled · aka estado FSM"@es .
cal:service_application_agreement_id a owl:ObjectProperty ; rdfs:domain cal:ServiceApplication ; rdfs:range cal:ServiceAgreement ; rdfs:label "agreement_id"@es ; rdfs:comment "Resulting contract; aka contratoId"@es .
cal:service_application_requested_at a owl:DatatypeProperty ; rdfs:domain cal:ServiceApplication ; rdfs:range xsd:dateTime ; rdfs:label "requested_at"@es ; rdfs:comment "aka fechaSolicitud"@es .
cal:service_application_form_data a owl:DatatypeProperty ; rdfs:domain cal:ServiceApplication ; rdfs:range xsd:string ; rdfs:label "form_data"@es ; rdfs:comment "Captured form snapshot; aka formData (schema-on-write pending in Hydra)"@es .

### Clase customer_case
cal:CustomerCase a owl:Class ; rdfs:label "Customer case"@es ; rdfs:comment "Complaint, clarification or procedure/trámite (aka QuejaAclaracion + Tramite; cambio de nombre, subrogación, baja...)."@es ; skos:note "clave: id"@es .
cal:customer_case_id a owl:DatatypeProperty ; rdfs:domain cal:CustomerCase ; rdfs:range xsd:string ; rdfs:label "id"@es ; rdfs:comment "requerido"@es .
cal:customer_case_folio a owl:DatatypeProperty ; rdfs:domain cal:CustomerCase ; rdfs:range xsd:string ; rdfs:label "folio"@es ; rdfs:comment "aka folio (trámites)"@es .
cal:customer_case_agreement_id a owl:ObjectProperty ; rdfs:domain cal:CustomerCase ; rdfs:range cal:ServiceAgreement ; rdfs:label "agreement_id"@es .
cal:customer_case_party_id a owl:ObjectProperty ; rdfs:domain cal:CustomerCase ; rdfs:range cal:Party ; rdfs:label "party_id"@es .
cal:customer_case_kind a owl:DatatypeProperty ; rdfs:domain cal:CustomerCase ; rdfs:range xsd:string ; rdfs:label "kind"@es ; rdfs:comment "requerido · valores: complaint, clarification, procedure · aka Queja/Aclaración/Tramite"@es .
cal:customer_case_type a owl:DatatypeProperty ; rdfs:domain cal:CustomerCase ; rdfs:range xsd:string ; rdfs:label "type"@es ; rdfs:comment "Procedure or complaint category; aka tipo/CatalogoTramite"@es .
cal:customer_case_description a owl:DatatypeProperty ; rdfs:domain cal:CustomerCase ; rdfs:range xsd:string ; rdfs:label "description"@es ; rdfs:comment "aka descripcion"@es .
cal:customer_case_channel a owl:DatatypeProperty ; rdfs:domain cal:CustomerCase ; rdfs:range xsd:string ; rdfs:label "channel"@es ; rdfs:comment "valores: counter, digital, phone, hybrid, other · aka canal Ventanilla/presencial/digital/hibrido"@es .
cal:customer_case_priority a owl:DatatypeProperty ; rdfs:domain cal:CustomerCase ; rdfs:range xsd:string ; rdfs:label "priority"@es ; rdfs:comment "aka prioridad"@es .
cal:customer_case_status a owl:DatatypeProperty ; rdfs:domain cal:CustomerCase ; rdfs:range xsd:string ; rdfs:label "status"@es ; rdfs:comment "aka estado + seguimientos"@es .
cal:customer_case_opened_at a owl:DatatypeProperty ; rdfs:domain cal:CustomerCase ; rdfs:range xsd:dateTime ; rdfs:label "opened_at"@es ; rdfs:comment "aka fecha/createdAt"@es .
cal:customer_case_resolved_at a owl:DatatypeProperty ; rdfs:domain cal:CustomerCase ; rdfs:range xsd:dateTime ; rdfs:label "resolved_at"@es ; rdfs:comment "aka fechaAprobacion/motivoCierre"@es .

### Clase accounting_voucher
cal:AccountingVoucher a owl:Class ; rdfs:label "Accounting voucher (header)"@es ; rdfs:comment "Daily accounting document exported to the ERP (aka Poliza → SAP IDOC file: Aqua_SAP control + Interfaz_AquaCis_SAP_Cabecera; types cobros/ingresos and facturación)."@es ; skos:note "clave: id"@es .
cal:accounting_voucher_id a owl:DatatypeProperty ; rdfs:domain cal:AccountingVoucher ; rdfs:range xsd:string ; rdfs:label "id"@es ; rdfs:comment "requerido"@es .
cal:accounting_voucher_number a owl:DatatypeProperty ; rdfs:domain cal:AccountingVoucher ; rdfs:range xsd:string ; rdfs:label "number"@es ; rdfs:comment "requerido · aka numero, IDOC DOCNUM"@es .
cal:accounting_voucher_type a owl:DatatypeProperty ; rdfs:domain cal:AccountingVoucher ; rdfs:range xsd:string ; rdfs:label "type"@es ; rdfs:comment "valores: collections, billing, adjustments, agreements, cancellations · aka tipo cobros/facturación; SAP BKTXT suffix PAGO vs oficina"@es .
cal:accounting_voucher_period a owl:DatatypeProperty ; rdfs:domain cal:AccountingVoucher ; rdfs:range xsd:string ; rdfs:label "period"@es ; rdfs:comment "requerido · aka periodo AAAAMM; SAP MONAT"@es .
cal:accounting_voucher_date a owl:DatatypeProperty ; rdfs:domain cal:AccountingVoucher ; rdfs:range xsd:date ; rdfs:label "date"@es ; rdfs:comment "requerido · aka fecha; SAP BLDAT/BUDAT DDMMAAAA"@es .
cal:accounting_voucher_currency a owl:DatatypeProperty ; rdfs:domain cal:AccountingVoucher ; rdfs:range xsd:string ; rdfs:label "currency"@es ; rdfs:comment "MXN; SAP WAERS"@es .
cal:accounting_voucher_description a owl:DatatypeProperty ; rdfs:domain cal:AccountingVoucher ; rdfs:range xsd:string ; rdfs:label "description"@es ; rdfs:comment "aka descripcion; SAP BKTXT"@es .
cal:accounting_voucher_status a owl:DatatypeProperty ; rdfs:domain cal:AccountingVoucher ; rdfs:range xsd:string ; rdfs:label "status"@es ; rdfs:comment "valores: generated, exported, sent, error, voided · aka estado generada/exportada/enviada/error/anulada"@es .
cal:accounting_voucher_export_file a owl:DatatypeProperty ; rdfs:domain cal:AccountingVoucher ; rdfs:range xsd:string ; rdfs:label "export_file"@es ; rdfs:comment "Generated IDOC file; aka archivoIdoc"@es .

### Clase accounting_voucher_line
cal:AccountingVoucherLine a owl:Class ; rdfs:label "Accounting voucher line"@es ; rdfs:comment "Voucher line (aka LineaPoliza → IDOC Interfaz_AquaCis_SAP_Posicion). GL account placement follows the posting key: 40/50 → NEWKO, 01-39 → HKONT with NEWKO=GENERICO."@es ; skos:note "clave: id"@es .
cal:accounting_voucher_line_id a owl:DatatypeProperty ; rdfs:domain cal:AccountingVoucherLine ; rdfs:range xsd:string ; rdfs:label "id"@es ; rdfs:comment "requerido"@es .
cal:accounting_voucher_line_voucher_id a owl:ObjectProperty ; rdfs:domain cal:AccountingVoucherLine ; rdfs:range cal:AccountingVoucher ; rdfs:label "voucher_id"@es ; rdfs:comment "requerido"@es .
cal:accounting_voucher_line_position a owl:DatatypeProperty ; rdfs:domain cal:AccountingVoucherLine ; rdfs:range xsd:integer ; rdfs:label "position"@es ; rdfs:comment "requerido · aka posicion; SAP SEGNUM"@es .
cal:accounting_voucher_line_posting_key a owl:DatatypeProperty ; rdfs:domain cal:AccountingVoucherLine ; rdfs:range xsd:string ; rdfs:label "posting_key"@es ; rdfs:comment "requerido · Debit/credit indicator; aka indicador, SAP BSCHL (40,15,01,50,12)"@es .
cal:accounting_voucher_line_amount a owl:DatatypeProperty ; rdfs:domain cal:AccountingVoucherLine ; rdfs:range xsd:decimal ; rdfs:label "amount"@es ; rdfs:comment "requerido · aka monto; SAP WRBTR"@es .
cal:accounting_voucher_line_tax_amount a owl:DatatypeProperty ; rdfs:domain cal:AccountingVoucherLine ; rdfs:range xsd:decimal ; rdfs:label "tax_amount"@es ; rdfs:comment "SAP WMWST/FWBAS"@es .
cal:accounting_voucher_line_gl_account a owl:DatatypeProperty ; rdfs:domain cal:AccountingVoucherLine ; rdfs:range xsd:string ; rdfs:label "gl_account"@es ; rdfs:comment "requerido · aka cuentaContable; SAP NEWKO/HKONT per posting key"@es .
cal:accounting_voucher_line_cost_center a owl:DatatypeProperty ; rdfs:domain cal:AccountingVoucherLine ; rdfs:range xsd:string ; rdfs:label "cost_center"@es ; rdfs:comment "CEBE/office; aka centroCoste, SAP KOSTL/PRCTR"@es .
cal:accounting_voucher_line_date a owl:DatatypeProperty ; rdfs:domain cal:AccountingVoucherLine ; rdfs:range xsd:date ; rdfs:label "date"@es ; rdfs:comment "aka fecha; SAP VALUT"@es .
cal:accounting_voucher_line_text a owl:DatatypeProperty ; rdfs:domain cal:AccountingVoucherLine ; rdfs:range xsd:string ; rdfs:label "text"@es ; rdfs:comment "aka descripcion/texto; SAP SGTXT"@es .

### Clase hydraulic_sector
cal:HydraulicSector a owl:Class ; rdfs:label "Hydraulic sector (DMA)"@es ; rdfs:comment "District metered area / sector hidráulico — the balance unit (aka SectorHidraulico; today only a catalog in Hydra, volumes pending macro-metering)."@es ; skos:note "clave: id"@es .
cal:hydraulic_sector_id a owl:DatatypeProperty ; rdfs:domain cal:HydraulicSector ; rdfs:range xsd:string ; rdfs:label "id"@es ; rdfs:comment "requerido"@es .
cal:hydraulic_sector_code a owl:DatatypeProperty ; rdfs:domain cal:HydraulicSector ; rdfs:range xsd:string ; rdfs:label "code"@es ; rdfs:comment "requerido · aka codigo"@es .
cal:hydraulic_sector_name a owl:DatatypeProperty ; rdfs:domain cal:HydraulicSector ; rdfs:range xsd:string ; rdfs:label "name"@es ; rdfs:comment "requerido · aka nombre"@es .
cal:hydraulic_sector_administration a owl:DatatypeProperty ; rdfs:domain cal:HydraulicSector ; rdfs:range xsd:string ; rdfs:label "administration"@es ; rdfs:comment "aka administracionId"@es .
cal:hydraulic_sector_geometry a owl:DatatypeProperty ; rdfs:domain cal:HydraulicSector ; rdfs:range xsd:string ; rdfs:label "geometry"@es ; rdfs:comment "GeoJSON polygon WGS84 (GIS layer when available)"@es .
cal:hydraulic_sector_mains_length_km a owl:DatatypeProperty ; rdfs:domain cal:HydraulicSector ; rdfs:range xsd:decimal ; rdfs:label "mains_length_km"@es ; rdfs:comment "Lm for UARL"@es .
cal:hydraulic_sector_service_connections a owl:DatatypeProperty ; rdfs:domain cal:HydraulicSector ; rdfs:range xsd:integer ; rdfs:label "service_connections"@es ; rdfs:comment "Nc for UARL"@es .
cal:hydraulic_sector_avg_pressure_m a owl:DatatypeProperty ; rdfs:domain cal:HydraulicSector ; rdfs:range xsd:decimal ; rdfs:label "avg_pressure_m"@es ; rdfs:comment "P for UARL"@es .

### Clase water_balance
cal:WaterBalance a owl:Class ; rdfs:label "Water balance (IWA/AWWA)"@es ; rdfs:comment "Standard IWA/AWWA water balance for a system or hydraulic sector and period. Components per Lambert & Hirner 2000 / AWWA M36: System Input Volume = Authorised Consumption (billed/unbilled × metered/unmetered) + Water Losses (apparent: unauthorised consumption, metering inaccuracies, data handling errors; real: mains leakage, storage leakage/overflows, service-connection leakage). NRW = unbilled authorised + apparent + real. Each volume carries an AWWA data grade."@es ; skos:note "clave: id"@es .
cal:water_balance_id a owl:DatatypeProperty ; rdfs:domain cal:WaterBalance ; rdfs:range xsd:string ; rdfs:label "id"@es ; rdfs:comment "requerido"@es .
cal:water_balance_hydraulic_sector_id a owl:ObjectProperty ; rdfs:domain cal:WaterBalance ; rdfs:range cal:HydraulicSector ; rdfs:label "hydraulic_sector_id"@es ; rdfs:comment "Null = whole system"@es .
cal:water_balance_period a owl:DatatypeProperty ; rdfs:domain cal:WaterBalance ; rdfs:range xsd:string ; rdfs:label "period"@es ; rdfs:comment "requerido · Audit period, usually YYYY"@es .
cal:water_balance_system_input_volume_m3 a owl:DatatypeProperty ; rdfs:domain cal:WaterBalance ; rdfs:range xsd:decimal ; rdfs:label "system_input_volume_m3"@es ; rdfs:comment "requerido · aka volumen producido/suministrado"@es .
cal:water_balance_billed_metered_m3 a owl:DatatypeProperty ; rdfs:domain cal:WaterBalance ; rdfs:range xsd:decimal ; rdfs:label "billed_metered_m3"@es ; rdfs:comment "Σ measured consumption billed; aka consumo facturado medido"@es .
cal:water_balance_billed_unmetered_m3 a owl:DatatypeProperty ; rdfs:domain cal:WaterBalance ; rdfs:range xsd:decimal ; rdfs:label "billed_unmetered_m3"@es ; rdfs:comment "aka cuota fija facturada"@es .
cal:water_balance_unbilled_metered_m3 a owl:DatatypeProperty ; rdfs:domain cal:WaterBalance ; rdfs:range xsd:decimal ; rdfs:label "unbilled_metered_m3"@es .
cal:water_balance_unbilled_unmetered_m3 a owl:DatatypeProperty ; rdfs:domain cal:WaterBalance ; rdfs:range xsd:decimal ; rdfs:label "unbilled_unmetered_m3"@es ; rdfs:comment "e.g. firefighting, network flushing"@es .
cal:water_balance_unauthorised_consumption_m3 a owl:DatatypeProperty ; rdfs:domain cal:WaterBalance ; rdfs:range xsd:decimal ; rdfs:label "unauthorised_consumption_m3"@es ; rdfs:comment "aka tomas clandestinas"@es .
cal:water_balance_metering_inaccuracies_m3 a owl:DatatypeProperty ; rdfs:domain cal:WaterBalance ; rdfs:range xsd:decimal ; rdfs:label "metering_inaccuracies_m3"@es ; rdfs:comment "aka submedición"@es .
cal:water_balance_data_handling_errors_m3 a owl:DatatypeProperty ; rdfs:domain cal:WaterBalance ; rdfs:range xsd:decimal ; rdfs:label "data_handling_errors_m3"@es .
cal:water_balance_real_losses_m3 a owl:DatatypeProperty ; rdfs:domain cal:WaterBalance ; rdfs:range xsd:decimal ; rdfs:label "real_losses_m3"@es ; rdfs:comment "aka pérdidas físicas/fugas"@es .
cal:water_balance_revenue_water_m3 a owl:DatatypeProperty ; rdfs:domain cal:WaterBalance ; rdfs:range xsd:decimal ; rdfs:label "revenue_water_m3"@es ; rdfs:comment "= billed authorised"@es .
cal:water_balance_non_revenue_water_m3 a owl:DatatypeProperty ; rdfs:domain cal:WaterBalance ; rdfs:range xsd:decimal ; rdfs:label "non_revenue_water_m3"@es ; rdfs:comment "NRW; aka agua no facturada"@es .
cal:water_balance_carl_l_day a owl:DatatypeProperty ; rdfs:domain cal:WaterBalance ; rdfs:range xsd:decimal ; rdfs:label "carl_l_day"@es ; rdfs:comment "Current Annual Real Losses"@es .
cal:water_balance_uarl_l_day a owl:DatatypeProperty ; rdfs:domain cal:WaterBalance ; rdfs:range xsd:decimal ; rdfs:label "uarl_l_day"@es ; rdfs:comment "(18×Lm + 0.8×Nc + 25×Lp) × P"@es .
cal:water_balance_ili a owl:DatatypeProperty ; rdfs:domain cal:WaterBalance ; rdfs:range xsd:decimal ; rdfs:label "ili"@es ; rdfs:comment "CARL/UARL — World Bank bands"@es .
cal:water_balance_data_validity_score a owl:DatatypeProperty ; rdfs:domain cal:WaterBalance ; rdfs:range xsd:integer ; rdfs:label "data_validity_score"@es ; rdfs:comment "AWWA FWAS composite grading"@es .
cal:water_balance_component_grades a owl:DatatypeProperty ; rdfs:domain cal:WaterBalance ; rdfs:range xsd:string ; rdfs:label "component_grades"@es ; rdfs:comment "Per-component AWWA data grade 1-10"@es .

### Clase performance_indicator
cal:PerformanceIndicator a owl:Class ; rdfs:label "Performance indicator value"@es ; rdfs:comment "KPI value per period computed from the commercial ledger, defined against a named standard (aka indicador PIGOO/IWA PI/IBNET). Core Mexican set (PIGOO, verified): IP.13 eficiencia física 1 (vol consumido/producido), IP.30 eficiencia física 2 (vol facturado/producido), IP.14 eficiencia comercial (vol cobrado/vol facturado — volumes), IP.15 eficiencia de cobro (pesos ingresados/facturados), IP.25 eficiencia global, IP.05 micromedición, IP.12 dotación l/hab/día, IP.10 empleados por mil tomas, IP.27/IP.28 pérdidas por toma/por km; plus internal commercial KPIs (% lecturas reales vs estimadas, periodo medio de cobranza IBNET 23.1, antigüedad de cartera)."@es ; skos:note "clave: id"@es .
cal:performance_indicator_id a owl:DatatypeProperty ; rdfs:domain cal:PerformanceIndicator ; rdfs:range xsd:string ; rdfs:label "id"@es ; rdfs:comment "requerido"@es .
cal:performance_indicator_standard a owl:DatatypeProperty ; rdfs:domain cal:PerformanceIndicator ; rdfs:range xsd:string ; rdfs:label "standard"@es ; rdfs:comment "requerido · valores: pigoo, iwa_pi, ibnet, awwa_m36, internal"@es .
cal:performance_indicator_code a owl:DatatypeProperty ; rdfs:domain cal:PerformanceIndicator ; rdfs:range xsd:string ; rdfs:label "code"@es ; rdfs:comment "requerido · e.g. PIGOO IP.14"@es .
cal:performance_indicator_name a owl:DatatypeProperty ; rdfs:domain cal:PerformanceIndicator ; rdfs:range xsd:string ; rdfs:label "name"@es ; rdfs:comment "requerido"@es .
cal:performance_indicator_formula a owl:DatatypeProperty ; rdfs:domain cal:PerformanceIndicator ; rdfs:range xsd:string ; rdfs:label "formula"@es ; rdfs:comment "Definition over ledger variables"@es .
cal:performance_indicator_unit a owl:DatatypeProperty ; rdfs:domain cal:PerformanceIndicator ; rdfs:range xsd:string ; rdfs:label "unit"@es .
cal:performance_indicator_period a owl:DatatypeProperty ; rdfs:domain cal:PerformanceIndicator ; rdfs:range xsd:string ; rdfs:label "period"@es ; rdfs:comment "requerido"@es .
cal:performance_indicator_scope a owl:DatatypeProperty ; rdfs:domain cal:PerformanceIndicator ; rdfs:range xsd:string ; rdfs:label "scope"@es ; rdfs:comment "System / administration / sector filter"@es .
cal:performance_indicator_value a owl:DatatypeProperty ; rdfs:domain cal:PerformanceIndicator ; rdfs:range xsd:decimal ; rdfs:label "value"@es ; rdfs:comment "requerido"@es .
cal:performance_indicator_confidence_grade a owl:DatatypeProperty ; rdfs:domain cal:PerformanceIndicator ; rdfs:range xsd:string ; rdfs:label "confidence_grade"@es ; rdfs:comment "IWA data confidence band / AWWA grade"@es .
