@prefix cal: <https://callosum.dev/ontology/agua#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .

<https://callosum.dev/ontology/agua> a owl:Ontology ;
    dcterms:title "Ontología canónica: agua"@es ;
    owl:versionInfo "0.1.0" ;
    dcterms:conformsTo "IWA/AWWA standard water balance (Lambert & Hirner 2000; AWWA M36 5th ed. with data validity grading) + IWA PI system (Alegre et al. 3rd ed. 2017) / IBNET / PIGOO (IMTA) for indicators; meter-to-cash core normalized from the IMTA \"Sistema comercial\" reference (comercialización, padrón, medición, facturación y cobranza) and the CIS vocabulary shared by Oracle CC&B / SAP IS-U."@es ;
    rdfs:comment "Canonical commercial-water-utility model (meter-to-cash + water balance), curated from Hydra (CEA Querétaro), AQUACIS reading flat files, SIGE legacy catalogs, external-collector payment layouts, SAP IDOC accounting interface and the IWA/AWWA/PIGOO standards. Conventions: dates ISO 8601 (date) and timestamps ISO 8601 UTC (datetime); money as decimal MXN major units with explicit currency field where another currency is possible; volumes in m3; readings in integer register units; geometry/points as GeoJSON WGS84; ids are opaque strings; enum values snake_case English. Header/line splits are explicit (bill/bill_line, accounting_voucher/accounting_voucher_line). Regulatory note: service cuts on domestic connections must be modeled as restriction to vital minimum, never total suspension (Ley General de Aguas, DOF 2025-12-11) — hence work_order.cut_impact."@es ;
    dcterms:source "callosum canonical model agua" .

### Clase party
cal:Party a owl:Class ; rdfs:label "Party"@es ; rdfs:comment "Person or organization holding contracts or roles (aka Persona, abonado, titular, propietario, ABONADO in AQUACIS)."@es ; skos:note "clave: id"@es .
cal:party_id a owl:DatatypeProperty ; rdfs:domain cal:Party ; rdfs:range xsd:string ; rdfs:label "id"@es ; rdfs:comment "requerido"@es .
cal:party_name a owl:DatatypeProperty ; rdfs:domain cal:Party ; rdfs:range xsd:string ; rdfs:label "name"@es ; rdfs:comment "requerido · Given name or razón social; aka nombre/razonSocial"@es .
cal:party_paternal_surname a owl:DatatypeProperty ; rdfs:domain cal:Party ; rdfs:range xsd:string ; rdfs:label "paternal_surname"@es ; rdfs:comment "aka apellidoPaterno"@es .
cal:party_maternal_surname a owl:DatatypeProperty ; rdfs:domain cal:Party ; rdfs:range xsd:string ; rdfs:label "maternal_surname"@es ; rdfs:comment "aka apellidoMaterno"@es .
cal:party_type a owl:DatatypeProperty ; rdfs:domain cal:Party ; rdfs:range xsd:string ; rdfs:label "type"@es ; rdfs:comment "valores: natural_person, organization · aka tipo persona Física/Moral"@es .
cal:party_tax_id a owl:DatatypeProperty ; rdfs:domain cal:Party ; rdfs:range xsd:string ; rdfs:label "tax_id"@es ; rdfs:comment "RFC (MX); aka rfc"@es .
cal:party_national_id a owl:DatatypeProperty ; rdfs:domain cal:Party ; rdfs:range xsd:string ; rdfs:label "national_id"@es ; rdfs:comment "CURP (MX); aka curp"@es .
cal:party_tax_regime a owl:DatatypeProperty ; rdfs:domain cal:Party ; rdfs:range xsd:string ; rdfs:label "tax_regime"@es ; rdfs:comment "SAT c_RegimenFiscal; aka regimenFiscal"@es .
cal:party_email a owl:DatatypeProperty ; rdfs:domain cal:Party ; rdfs:range xsd:string ; rdfs:label "email"@es .
cal:party_phone a owl:DatatypeProperty ; rdfs:domain cal:Party ; rdfs:range xsd:string ; rdfs:label "phone"@es ; rdfs:comment "aka telefono/telefonoAlt"@es .
cal:party_id_document a owl:DatatypeProperty ; rdfs:domain cal:Party ; rdfs:range xsd:string ; rdfs:label "id_document"@es ; rdfs:comment "Identification kind+number (INE, pasaporte, licencia); aka tipoIdentificacion/numIdentificacion"@es .

### Clase party_role
cal:PartyRole a owl:Class ; rdfs:label "Party role on agreement"@es ; rdfs:comment "Links a party to a service agreement with a role and validity window (aka RolPersonaContrato; roles PROPIETARIO/FISCAL/CONTACTO)."@es ; skos:note "clave: id"@es .
cal:party_role_id a owl:DatatypeProperty ; rdfs:domain cal:PartyRole ; rdfs:range xsd:string ; rdfs:label "id"@es ; rdfs:comment "requerido"@es .
cal:party_role_party_id a owl:ObjectProperty ; rdfs:domain cal:PartyRole ; rdfs:range cal:Party ; rdfs:label "party_id"@es ; rdfs:comment "requerido"@es .
cal:party_role_agreement_id a owl:ObjectProperty ; rdfs:domain cal:PartyRole ; rdfs:range cal:ServiceAgreement ; rdfs:label "agreement_id"@es ; rdfs:comment "requerido"@es .
cal:party_role_role a owl:DatatypeProperty ; rdfs:domain cal:PartyRole ; rdfs:range xsd:string ; rdfs:label "role"@es ; rdfs:comment "requerido · valores: owner, fiscal, contact, tenant, other · aka rol PROPIETARIO/FISCAL/CONTACTO"@es .
cal:party_role_valid_from a owl:DatatypeProperty ; rdfs:domain cal:PartyRole ; rdfs:range xsd:dateTime ; rdfs:label "valid_from"@es ; rdfs:comment "aka fechaDesde"@es .
cal:party_role_valid_to a owl:DatatypeProperty ; rdfs:domain cal:PartyRole ; rdfs:range xsd:dateTime ; rdfs:label "valid_to"@es ; rdfs:comment "aka fechaHasta; null = current"@es .

### Clase address
cal:Address a owl:Class ; rdfs:label "Address"@es ; rdfs:comment "Normalized service/fiscal address with INEGI hierarchy and legacy Aquasis keys (aka Domicilio; AQUACIS DIR*/NCALNOMBRE/BARRIO/MUNICIPIO)."@es ; skos:note "clave: id"@es .
cal:address_id a owl:DatatypeProperty ; rdfs:domain cal:Address ; rdfs:range xsd:string ; rdfs:label "id"@es ; rdfs:comment "requerido"@es .
cal:address_street a owl:DatatypeProperty ; rdfs:domain cal:Address ; rdfs:range xsd:string ; rdfs:label "street"@es ; rdfs:comment "requerido · aka calle, NCALNOMBRE"@es .
cal:address_exterior_number a owl:DatatypeProperty ; rdfs:domain cal:Address ; rdfs:range xsd:string ; rdfs:label "exterior_number"@es ; rdfs:comment "aka numExterior, DIRFINCA"@es .
cal:address_interior_number a owl:DatatypeProperty ; rdfs:domain cal:Address ; rdfs:range xsd:string ; rdfs:label "interior_number"@es ; rdfs:comment "aka numInterior, DIRCOMFINCA"@es .
cal:address_neighborhood_key a owl:DatatypeProperty ; rdfs:domain cal:Address ; rdfs:range xsd:string ; rdfs:label "neighborhood_key"@es ; rdfs:comment "Colonia key; aka aquasisBarrId (Aquasis barrid), CatalogoColoniaINEGI"@es .
cal:address_locality_key a owl:DatatypeProperty ; rdfs:domain cal:Address ; rdfs:range xsd:string ; rdfs:label "locality_key"@es ; rdfs:comment "Localidad key; aka aquasisPobid (Aquasis pobid), CatalogoLocalidadINEGI; NOTE AQUACIS labels this field BARRIO in the reading file"@es .
cal:address_municipality_key a owl:DatatypeProperty ; rdfs:domain cal:Address ; rdfs:range xsd:string ; rdfs:label "municipality_key"@es ; rdfs:comment "INEGI municipio key; aka claveINEGI, SIGE proid; AQUACIS MUNICIPIO/Población"@es .
cal:address_state_key a owl:DatatypeProperty ; rdfs:domain cal:Address ; rdfs:range xsd:string ; rdfs:label "state_key"@es ; rdfs:comment "INEGI estado key (22 = Querétaro)"@es .
cal:address_postal_code a owl:DatatypeProperty ; rdfs:domain cal:Address ; rdfs:range xsd:string ; rdfs:label "postal_code"@es ; rdfs:comment "aka codigoPostal"@es .
cal:address_between_streets a owl:DatatypeProperty ; rdfs:domain cal:Address ; rdfs:range xsd:string ; rdfs:label "between_streets"@es ; rdfs:comment "aka entreCalle1/entreCalle2"@es .
cal:address_reference_point a owl:DatatypeProperty ; rdfs:domain cal:Address ; rdfs:range xsd:string ; rdfs:label "reference_point"@es ; rdfs:comment "GeoJSON point WGS84; aka gpsLat/gpsLng"@es .
cal:address_inegi_validated a owl:DatatypeProperty ; rdfs:domain cal:Address ; rdfs:range xsd:boolean ; rdfs:label "inegi_validated"@es ; rdfs:comment "aka validadoINEGI"@es .

### Clase service_point
cal:ServicePoint a owl:Class ; rdfs:label "Service point"@es ; rdfs:comment "Physical connection where service is delivered (aka PuntoServicio, toma, AQUACIS PTOSID; legacy Hydra Toma folds in here). Supports parent-child hierarchy with consumption split (macro meter / condominio individualization) and the cuttability flag."@es ; skos:note "clave: id"@es .
cal:service_point_id a owl:DatatypeProperty ; rdfs:domain cal:ServicePoint ; rdfs:range xsd:string ; rdfs:label "id"@es ; rdfs:comment "requerido"@es .
cal:service_point_code a owl:DatatypeProperty ; rdfs:domain cal:ServicePoint ; rdfs:range xsd:string ; rdfs:label "code"@es ; rdfs:comment "requerido · Business code; aka codigo, PTOSID"@es .
cal:service_point_address_id a owl:ObjectProperty ; rdfs:domain cal:ServicePoint ; rdfs:range cal:Address ; rdfs:label "address_id"@es .
cal:service_point_service_type a owl:DatatypeProperty ; rdfs:domain cal:ServicePoint ; rdfs:range xsd:string ; rdfs:label "service_type"@es ; rdfs:comment "valores: water, sewerage, sanitation, mixed · aka tipo Agua/Alcantarillado/Saneamiento"@es .
cal:service_point_supply_type a owl:DatatypeProperty ; rdfs:domain cal:ServicePoint ; rdfs:range xsd:string ; rdfs:label "supply_type"@es ; rdfs:comment "aka CatalogoTipoSuministro (reading period MENSUAL/BIMESTRAL, requiere medidor), AQUACIS TIPOSUMINISTRO"@es .
cal:service_point_connection_diameter a owl:DatatypeProperty ; rdfs:domain cal:ServicePoint ; rdfs:range xsd:string ; rdfs:label "connection_diameter"@es ; rdfs:comment "aka diametroToma"@es .
cal:service_point_pipe_material a owl:DatatypeProperty ; rdfs:domain cal:ServicePoint ; rdfs:range xsd:string ; rdfs:label "pipe_material"@es ; rdfs:comment "aka materialTuberia"@es .
cal:service_point_location a owl:DatatypeProperty ; rdfs:domain cal:ServicePoint ; rdfs:range xsd:string ; rdfs:label "location"@es ; rdfs:comment "GeoJSON point WGS84; aka gpsLat/gpsLng"@es .
cal:service_point_cadastral_key a owl:DatatypeProperty ; rdfs:domain cal:ServicePoint ; rdfs:range xsd:string ; rdfs:label "cadastral_key"@es ; rdfs:comment "Link to catastro parcel; aka claveCatastral, AQUACIS PTOSREFCAT"@es .
cal:service_point_hydraulic_sector_id a owl:ObjectProperty ; rdfs:domain cal:ServicePoint ; rdfs:range cal:HydraulicSector ; rdfs:label "hydraulic_sector_id"@es ; rdfs:comment "DMA membership for the water balance"@es .
cal:service_point_parent_service_point_id a owl:ObjectProperty ; rdfs:domain cal:ServicePoint ; rdfs:range cal:ServicePoint ; rdfs:label "parent_service_point_id"@es ; rdfs:comment "aka puntoServicioPadreId, AQUACIS POLIZAPADRE (macro meter)"@es .
cal:service_point_consumption_split_pct a owl:DatatypeProperty ; rdfs:domain cal:ServicePoint ; rdfs:range xsd:decimal ; rdfs:label "consumption_split_pct"@es ; rdfs:comment "% of parent consumption assigned to this child; aka reparticionConsumo"@es .
cal:service_point_cuttable a owl:DatatypeProperty ; rdfs:domain cal:ServicePoint ; rdfs:range xsd:boolean ; rdfs:label "cuttable"@es ; rdfs:comment "Whether restriction orders may target it; aka cortable/motivoNoCortable"@es .
cal:service_point_route_code a owl:DatatypeProperty ; rdfs:domain cal:ServicePoint ; rdfs:range xsd:string ; rdfs:label "route_code"@es ; rdfs:comment "Reading walk-order; aka codigoRecorrido, AQUACIS LECPTOCODR"@es .
cal:service_point_status a owl:DatatypeProperty ; rdfs:domain cal:ServicePoint ; rdfs:range xsd:string ; rdfs:label "status"@es ; rdfs:comment "valores: active, inactive, available, assigned · aka estado"@es .

### Clase service_agreement
cal:ServiceAgreement a owl:Class ; rdfs:label "Service agreement (contract)"@es ; rdfs:comment "The commercial contract binding parties to a service point — hub of the meter-to-cash cycle (aka Contrato, AQUACIS LECCNTTNUM, SIGE cnttnum; legacy references ceaNumContrato/cnttrefant)."@es ; skos:note "clave: id"@es .
cal:service_agreement_id a owl:DatatypeProperty ; rdfs:domain cal:ServiceAgreement ; rdfs:range xsd:string ; rdfs:label "id"@es ; rdfs:comment "requerido"@es .
cal:service_agreement_contract_number a owl:DatatypeProperty ; rdfs:domain cal:ServiceAgreement ; rdfs:range xsd:string ; rdfs:label "contract_number"@es ; rdfs:comment "requerido · Business number; aka numeroContrato, CONTRATO AQUACIS in collector files"@es .
cal:service_agreement_legacy_references a owl:DatatypeProperty ; rdfs:domain cal:ServiceAgreement ; rdfs:range xsd:string ; rdfs:label "legacy_references"@es ; rdfs:comment "Prior-system numbers: {cea: ceaNumContrato, sige: cnttnum/cnttrefant, aquacis: ...}; aka referenciaContratoAnterior"@es .
cal:service_agreement_service_point_id a owl:ObjectProperty ; rdfs:domain cal:ServiceAgreement ; rdfs:range cal:ServicePoint ; rdfs:label "service_point_id"@es .
cal:service_agreement_address_id a owl:ObjectProperty ; rdfs:domain cal:ServiceAgreement ; rdfs:range cal:Address ; rdfs:label "address_id"@es .
cal:service_agreement_service_class_id a owl:ObjectProperty ; rdfs:domain cal:ServiceAgreement ; rdfs:range cal:ServiceClass ; rdfs:label "service_class_id"@es ; rdfs:comment "aka tipoContratacionId, SIGE tctcod"@es .
cal:service_agreement_service_type a owl:DatatypeProperty ; rdfs:domain cal:ServiceAgreement ; rdfs:range xsd:string ; rdfs:label "service_type"@es ; rdfs:comment "valores: water, sewerage, sanitation, mixed · aka tipoServicio"@es .
cal:service_agreement_use_category a owl:DatatypeProperty ; rdfs:domain cal:ServiceAgreement ; rdfs:range xsd:string ; rdfs:label "use_category"@es ; rdfs:comment "valores: domestic, non_domestic · Drives IVA exemption and no-total-cut rule; aka AQUACIS USO 1/0"@es .
cal:service_agreement_activity_code a owl:DatatypeProperty ; rdfs:domain cal:ServiceAgreement ; rdfs:range xsd:string ; rdfs:label "activity_code"@es ; rdfs:comment "Economic activity; aka CatalogoActividad CIG2018, SIGE ACTIPOL_*, AQUACIS CNTTACTIVID"@es .
cal:service_agreement_billing_cycle a owl:DatatypeProperty ; rdfs:domain cal:ServiceAgreement ; rdfs:range xsd:string ; rdfs:label "billing_cycle"@es ; rdfs:comment "valores: monthly, bimonthly, quarterly, biannual, annual · aka cicloFacturacion"@es .
cal:service_agreement_status a owl:DatatypeProperty ; rdfs:domain cal:ServiceAgreement ; rdfs:range xsd:string ; rdfs:label "status"@es ; rdfs:comment "valores: active, suspended, restricted, canceled, in_process · aka estado, AQUACIS CNTTESTADO"@es .
cal:service_agreement_legal_hold a owl:DatatypeProperty ; rdfs:domain cal:ServiceAgreement ; rdfs:range xsd:boolean ; rdfs:label "legal_hold"@es ; rdfs:comment "aka bloqueadoJuridico"@es .
cal:service_agreement_direct_debit a owl:DatatypeProperty ; rdfs:domain cal:ServiceAgreement ; rdfs:range xsd:boolean ; rdfs:label "direct_debit"@es ; rdfs:comment "aka domiciliado"@es .
cal:service_agreement_bill_delivery a owl:DatatypeProperty ; rdfs:domain cal:ServiceAgreement ; rdfs:range xsd:string ; rdfs:label "bill_delivery"@es ; rdfs:comment "valores: paper, pdf, paper_and_pdf · aka tipoEnvioFactura"@es .
cal:service_agreement_served_units a owl:DatatypeProperty ; rdfs:domain cal:ServiceAgreement ; rdfs:range xsd:integer ; rdfs:label "served_units"@es ; rdfs:comment "Housing/commercial units served (tariff divisor); aka unidadesServidas, AQUACIS VIVIENDAS"@es .
cal:service_agreement_start_date a owl:DatatypeProperty ; rdfs:domain cal:ServiceAgreement ; rdfs:range xsd:date ; rdfs:label "start_date"@es ; rdfs:comment "aka fecha (String in Hydra — normalize to ISO)"@es .
cal:service_agreement_end_date a owl:DatatypeProperty ; rdfs:domain cal:ServiceAgreement ; rdfs:range xsd:date ; rdfs:label "end_date"@es ; rdfs:comment "aka fechaBaja"@es .
cal:service_agreement_zone_path a owl:DatatypeProperty ; rdfs:domain cal:ServiceAgreement ; rdfs:range xsd:string ; rdfs:label "zone_path"@es ; rdfs:comment "Operational hierarchy {administration, zone, district, route}; aka Administracion/Zona/Distrito/Ruta, SIGE expid, AQUACIS LOTPLECEXPID/ZONID"@es .
cal:service_agreement_contract_text_snapshot a owl:DatatypeProperty ; rdfs:domain cal:ServiceAgreement ; rdfs:range xsd:string ; rdfs:label "contract_text_snapshot"@es ; rdfs:comment "aka textoContratoSnapshot (versioned clauses)"@es .

### Clase service_class
cal:ServiceClass a owl:Class ; rdfs:label "Service class (contracting type)"@es ; rdfs:comment "Parameterized user/tariff class (aka TipoContratacion, clase de usuario — 11 CEA classes; SIGE tctcod/tctclsccod)."@es ; skos:note "clave: id"@es .
cal:service_class_id a owl:DatatypeProperty ; rdfs:domain cal:ServiceClass ; rdfs:range xsd:string ; rdfs:label "id"@es ; rdfs:comment "requerido"@es .
cal:service_class_code a owl:DatatypeProperty ; rdfs:domain cal:ServiceClass ; rdfs:range xsd:string ; rdfs:label "code"@es ; rdfs:comment "requerido · aka codigo, TCT-*"@es .
cal:service_class_name a owl:DatatypeProperty ; rdfs:domain cal:ServiceClass ; rdfs:range xsd:string ; rdfs:label "name"@es ; rdfs:comment "requerido"@es .
cal:service_class_requires_meter a owl:DatatypeProperty ; rdfs:domain cal:ServiceClass ; rdfs:range xsd:boolean ; rdfs:label "requires_meter"@es ; rdfs:comment "aka requiereMedidor; SIGE sheet 'sin medidor'"@es .
cal:service_class_requires_inspection a owl:DatatypeProperty ; rdfs:domain cal:ServiceClass ; rdfs:range xsd:boolean ; rdfs:label "requires_inspection"@es ; rdfs:comment "aka requiereInspeccion"@es .
cal:service_class_is_individualization a owl:DatatypeProperty ; rdfs:domain cal:ServiceClass ; rdfs:range xsd:boolean ; rdfs:label "is_individualization"@es ; rdfs:comment "aka esIndividualizacion (condominio sub-metering)"@es .
cal:service_class_allowed_periodicities a owl:DatatypeProperty ; rdfs:domain cal:ServiceClass ; rdfs:range xsd:string ; rdfs:label "allowed_periodicities"@es ; rdfs:comment "aka periodicidadesPermitidas"@es .
cal:service_class_active a owl:DatatypeProperty ; rdfs:domain cal:ServiceClass ; rdfs:range xsd:boolean ; rdfs:label "active"@es .

### Clase meter
cal:Meter a owl:Class ; rdfs:label "Meter"@es ; rdfs:comment "Installed water meter (aka Medidor, contador, AQUACIS CONTNUMERO/CONTCALMM/MARCA)."@es ; skos:note "clave: id"@es .
cal:meter_id a owl:DatatypeProperty ; rdfs:domain cal:Meter ; rdfs:range xsd:string ; rdfs:label "id"@es ; rdfs:comment "requerido"@es .
cal:meter_agreement_id a owl:ObjectProperty ; rdfs:domain cal:Meter ; rdfs:range cal:ServiceAgreement ; rdfs:label "agreement_id"@es ; rdfs:comment "requerido"@es .
cal:meter_serial_number a owl:DatatypeProperty ; rdfs:domain cal:Meter ; rdfs:range xsd:string ; rdfs:label "serial_number"@es ; rdfs:comment "requerido · aka serie, CONTNUMERO"@es .
cal:meter_brand a owl:DatatypeProperty ; rdfs:domain cal:Meter ; rdfs:range xsd:string ; rdfs:label "brand"@es ; rdfs:comment "aka CatalogoMarcaMedidor, AQUACIS MARCA"@es .
cal:meter_model a owl:DatatypeProperty ; rdfs:domain cal:Meter ; rdfs:range xsd:string ; rdfs:label "model"@es ; rdfs:comment "aka CatalogoModeloMedidor"@es .
cal:meter_caliber a owl:DatatypeProperty ; rdfs:domain cal:Meter ; rdfs:range xsd:string ; rdfs:label "caliber"@es ; rdfs:comment "aka CatalogoCalibre (mm), AQUACIS CONTCALMM / CALIEQPUL (pulgadas)"@es .
cal:meter_digits a owl:DatatypeProperty ; rdfs:domain cal:Meter ; rdfs:range xsd:integer ; rdfs:label "digits"@es ; rdfs:comment "Register digit count for rollover; aka digitos"@es .
cal:meter_placement a owl:DatatypeProperty ; rdfs:domain cal:Meter ; rdfs:range xsd:string ; rdfs:label "placement"@es ; rdfs:comment "valores: interior, exterior · aka CatalogoEmplazamiento, AQUACIS EMPLINTEXT/SITUACION"@es .
cal:meter_telemetry_type a owl:DatatypeProperty ; rdfs:domain cal:Meter ; rdfs:range xsd:string ; rdfs:label "telemetry_type"@es ; rdfs:comment "AMI/AMR protocol when present (DLMS/COSEM, wM-Bus, LoRaWAN, NB-IoT); aka tipoTelemetria"@es .
cal:meter_initial_reading a owl:DatatypeProperty ; rdfs:domain cal:Meter ; rdfs:range xsd:integer ; rdfs:label "initial_reading"@es ; rdfs:comment "aka lecturaInicial"@es .
cal:meter_installed_at a owl:DatatypeProperty ; rdfs:domain cal:Meter ; rdfs:range xsd:date ; rdfs:label "installed_at"@es ; rdfs:comment "aka fechaInstalacion"@es .
cal:meter_last_verified_at a owl:DatatypeProperty ; rdfs:domain cal:Meter ; rdfs:range xsd:date ; rdfs:label "last_verified_at"@es ; rdfs:comment "aka fechaUltimaVerif"@es .
cal:meter_status a owl:DatatypeProperty ; rdfs:domain cal:Meter ; rdfs:range xsd:string ; rdfs:label "status"@es ; rdfs:comment "valores: installed, in_stock, in_repair, retired · aka estado + MedidorBodega"@es .

### Clase reading_batch
cal:ReadingBatch a owl:Class ; rdfs:label "Reading batch (lot)"@es ; rdfs:comment "Reading work unit exchanged with the field (aka LoteLecturas; AQUACIS lot file named administración(4)+zona(3)+lote(3), e.g. 0001M08L20, /Salida → /Entrada round trip; lot types L lectura / I inspección / R repaso)."@es ; skos:note "clave: id"@es .
cal:reading_batch_id a owl:DatatypeProperty ; rdfs:domain cal:ReadingBatch ; rdfs:range xsd:string ; rdfs:label "id"@es ; rdfs:comment "requerido"@es .
cal:reading_batch_period a owl:DatatypeProperty ; rdfs:domain cal:ReadingBatch ; rdfs:range xsd:string ; rdfs:label "period"@es ; rdfs:comment "requerido · Billing period YYYY-MM; aka periodo, LOTPLECANNO+PERNUM"@es .
cal:reading_batch_batch_type a owl:DatatypeProperty ; rdfs:domain cal:ReadingBatch ; rdfs:range xsd:string ; rdfs:label "batch_type"@es ; rdfs:comment "valores: reading, inspection, reread · aka tipoLote, AQUACIS LOTTIPO L/I/R"@es .
cal:reading_batch_zone_path a owl:DatatypeProperty ; rdfs:domain cal:ReadingBatch ; rdfs:range xsd:string ; rdfs:label "zone_path"@es ; rdfs:comment "aka zonaId/rutaId, LOTPLECEXPID/LOTPLECZONID/LOTNUMERO"@es .
cal:reading_batch_file_name a owl:DatatypeProperty ; rdfs:domain cal:ReadingBatch ; rdfs:range xsd:string ; rdfs:label "file_name"@es ; rdfs:comment "Source flat file; aka archivoNombre"@es .
cal:reading_batch_file_hash a owl:DatatypeProperty ; rdfs:domain cal:ReadingBatch ; rdfs:range xsd:string ; rdfs:label "file_hash"@es ; rdfs:comment "aka archivoHash"@es .
cal:reading_batch_status a owl:DatatypeProperty ; rdfs:domain cal:ReadingBatch ; rdfs:range xsd:string ; rdfs:label "status"@es ; rdfs:comment "valores: pending, emitted, returned, validated, loaded, error · aka estado; AQUACIS blocks loading until every contract has reading or incidence"@es .
cal:reading_batch_totals a owl:DatatypeProperty ; rdfs:domain cal:ReadingBatch ; rdfs:range xsd:string ; rdfs:label "totals"@es ; rdfs:comment "{records, valid, errors}; aka totalRegistros/totalValidos/totalConError"@es .

### Clase meter_reading
cal:MeterReading a owl:Class ; rdfs:label "Meter reading"@es ; rdfs:comment "Individual reading within a batch (aka Lectura; AQUACIS LECTURA/FECHALEC/HORALEC + OBSERVAC incidence + LECTOR/CONTRATISTA + Foto)."@es ; skos:note "clave: id"@es .
cal:meter_reading_id a owl:DatatypeProperty ; rdfs:domain cal:MeterReading ; rdfs:range xsd:string ; rdfs:label "id"@es ; rdfs:comment "requerido"@es .
cal:meter_reading_batch_id a owl:ObjectProperty ; rdfs:domain cal:MeterReading ; rdfs:range cal:ReadingBatch ; rdfs:label "batch_id"@es ; rdfs:comment "requerido"@es .
cal:meter_reading_agreement_id a owl:ObjectProperty ; rdfs:domain cal:MeterReading ; rdfs:range cal:ServiceAgreement ; rdfs:label "agreement_id"@es ; rdfs:comment "requerido"@es .
cal:meter_reading_period a owl:DatatypeProperty ; rdfs:domain cal:MeterReading ; rdfs:range xsd:string ; rdfs:label "period"@es ; rdfs:comment "requerido"@es .
cal:meter_reading_reading_value a owl:DatatypeProperty ; rdfs:domain cal:MeterReading ; rdfs:range xsd:integer ; rdfs:label "reading_value"@es ; rdfs:comment "Register units; aka lecturaActual, AQUACIS LECTURA"@es .
cal:meter_reading_previous_reading a owl:DatatypeProperty ; rdfs:domain cal:MeterReading ; rdfs:range xsd:integer ; rdfs:label "previous_reading"@es ; rdfs:comment "aka lecturaAnterior, AQUACIS LECANTERIO"@es .
cal:meter_reading_expected_range a owl:DatatypeProperty ; rdfs:domain cal:MeterReading ; rdfs:range xsd:string ; rdfs:label "expected_range"@es ; rdfs:comment "{min,max} plausibility band; aka lecturaMinZona/MaxZona, AQUACIS LECESPINF/LECESPSUP"@es .
cal:meter_reading_read_at a owl:DatatypeProperty ; rdfs:domain cal:MeterReading ; rdfs:range xsd:dateTime ; rdfs:label "read_at"@es ; rdfs:comment "Field capture timestamp; aka AQUACIS FECHALEC+HORALEC"@es .
cal:meter_reading_incidence_code a owl:ObjectProperty ; rdfs:domain cal:MeterReading ; rdfs:range cal:ReadingIncidence ; rdfs:label "incidence_code"@es ; rdfs:comment "aka incidenciaId, AQUACIS OBSERVAC (2-char Observac.dat key)"@es .
cal:meter_reading_is_estimated a owl:DatatypeProperty ; rdfs:domain cal:MeterReading ; rdfs:range xsd:boolean ; rdfs:label "is_estimated"@es ; rdfs:comment "aka esEstimada; AQUACIS estimates on avería incidences at load"@es .
cal:meter_reading_reader_code a owl:DatatypeProperty ; rdfs:domain cal:MeterReading ; rdfs:range xsd:string ; rdfs:label "reader_code"@es ; rdfs:comment "aka Lecturista.codigo, AQUACIS LECTOR"@es .
cal:meter_reading_crew_code a owl:DatatypeProperty ; rdfs:domain cal:MeterReading ; rdfs:range xsd:string ; rdfs:label "crew_code"@es ; rdfs:comment "Contractor/cuadrilla; aka Contratista, AQUACIS CONTRATISTA (Lectores.dat)"@es .
cal:meter_reading_photo_url a owl:DatatypeProperty ; rdfs:domain cal:MeterReading ; rdfs:range xsd:string ; rdfs:label "photo_url"@es ; rdfs:comment "Field evidence; aka urlFoto, AQUACIS Foto"@es .
cal:meter_reading_status a owl:DatatypeProperty ; rdfs:domain cal:MeterReading ; rdfs:range xsd:string ; rdfs:label "status"@es ; rdfs:comment "valores: pending, valid, invalid · aka estado/motivoInvalidacion"@es .
cal:meter_reading_raw_record a owl:DatatypeProperty ; rdfs:domain cal:MeterReading ; rdfs:range xsd:string ; rdfs:label "raw_record"@es ; rdfs:comment "Original flat-file record; aka datosRaw"@es .

### Clase reading_incidence
cal:ReadingIncidence a owl:Class ; rdfs:label "Reading incidence"@es ; rdfs:comment "Incidence/observation catalog (aka CatalogoIncidencia; AQUACIS Observac.dat 2-char keys: FA/FU fuga, CE/CB consumo excesivo/bajo, PA medidor parado, CD cerrado, NO no localizado...)."@es ; skos:note "clave: code"@es .
cal:reading_incidence_code a owl:DatatypeProperty ; rdfs:domain cal:ReadingIncidence ; rdfs:range xsd:string ; rdfs:label "code"@es ; rdfs:comment "requerido · aka clave, OBSERVAC"@es .
cal:reading_incidence_description a owl:DatatypeProperty ; rdfs:domain cal:ReadingIncidence ; rdfs:range xsd:string ; rdfs:label "description"@es ; rdfs:comment "requerido"@es .
cal:reading_incidence_is_fault a owl:DatatypeProperty ; rdfs:domain cal:ReadingIncidence ; rdfs:range xsd:boolean ; rdfs:label "is_fault"@es ; rdfs:comment "Avería → triggers estimation; aka esAveria"@es .
cal:reading_incidence_active a owl:DatatypeProperty ; rdfs:domain cal:ReadingIncidence ; rdfs:range xsd:boolean ; rdfs:label "active"@es .

### Clase consumption
cal:Consumption a owl:Class ; rdfs:label "Consumption"@es ; rdfs:comment "Consumption per agreement-period in m3, real or estimated (aka Consumo; feeds billing and the billed-metered balance component)."@es ; skos:note "clave: id"@es .
cal:consumption_id a owl:DatatypeProperty ; rdfs:domain cal:Consumption ; rdfs:range xsd:string ; rdfs:label "id"@es ; rdfs:comment "requerido"@es .
cal:consumption_agreement_id a owl:ObjectProperty ; rdfs:domain cal:Consumption ; rdfs:range cal:ServiceAgreement ; rdfs:label "agreement_id"@es ; rdfs:comment "requerido"@es .
cal:consumption_period a owl:DatatypeProperty ; rdfs:domain cal:Consumption ; rdfs:range xsd:string ; rdfs:label "period"@es ; rdfs:comment "requerido · YYYY-MM"@es .
cal:consumption_volume_m3 a owl:DatatypeProperty ; rdfs:domain cal:Consumption ; rdfs:range xsd:decimal ; rdfs:label "volume_m3"@es ; rdfs:comment "requerido · aka m3"@es .
cal:consumption_determination a owl:DatatypeProperty ; rdfs:domain cal:Consumption ; rdfs:range xsd:string ; rdfs:label "determination"@es ; rdfs:comment "valores: measured, historical_average, mixed, fixed_quota · aka tipo Real/Promedio histórico/Mixto/Consumo fijo"@es .
cal:consumption_confirmed a owl:DatatypeProperty ; rdfs:domain cal:Consumption ; rdfs:range xsd:boolean ; rdfs:label "confirmed"@es ; rdfs:comment "aka confirmado (billing gate)"@es .

### Clase tariff
cal:Tariff a owl:Class ; rdfs:label "Tariff block"@es ; rdfs:comment "Tariff rule: service class × service type × consumption block with unit price or fixed charge and validity window (aka Tarifa; Mexican pattern: 11 user classes × increasing m3 blocks + fixed charge + 10% sewerage + 12% sanitation surcharges + IVA only non-domestic, Art. 154 Consejo Directivo / Acuerdo de Precios)."@es ; skos:note "clave: id"@es .
cal:tariff_id a owl:DatatypeProperty ; rdfs:domain cal:Tariff ; rdfs:range xsd:string ; rdfs:label "id"@es ; rdfs:comment "requerido"@es .
cal:tariff_code a owl:DatatypeProperty ; rdfs:domain cal:Tariff ; rdfs:range xsd:string ; rdfs:label "code"@es ; rdfs:comment "requerido · aka codigo"@es .
cal:tariff_service_class_code a owl:DatatypeProperty ; rdfs:domain cal:Tariff ; rdfs:range xsd:string ; rdfs:label "service_class_code"@es ; rdfs:comment "aka tipoContratacionCodigo (string join in Hydra — canonical keeps the code but mappings should resolve the FK)"@es .
cal:tariff_service_type a owl:DatatypeProperty ; rdfs:domain cal:Tariff ; rdfs:range xsd:string ; rdfs:label "service_type"@es ; rdfs:comment "valores: water, sewerage, sanitation · aka tipoServicio"@es .
cal:tariff_calc_method a owl:DatatypeProperty ; rdfs:domain cal:Tariff ; rdfs:range xsd:string ; rdfs:label "calc_method"@es ; rdfs:comment "valores: block, fixed, variable · aka tipoCalculo escalonado/fijo/variable"@es .
cal:tariff_block_min_m3 a owl:DatatypeProperty ; rdfs:domain cal:Tariff ; rdfs:range xsd:integer ; rdfs:label "block_min_m3"@es ; rdfs:comment "aka rangoMinM3"@es .
cal:tariff_block_max_m3 a owl:DatatypeProperty ; rdfs:domain cal:Tariff ; rdfs:range xsd:integer ; rdfs:label "block_max_m3"@es ; rdfs:comment "aka rangoMaxM3"@es .
cal:tariff_unit_price a owl:DatatypeProperty ; rdfs:domain cal:Tariff ; rdfs:range xsd:decimal ; rdfs:label "unit_price"@es ; rdfs:comment "MXN per m3; aka precioUnitario"@es .
cal:tariff_fixed_charge a owl:DatatypeProperty ; rdfs:domain cal:Tariff ; rdfs:range xsd:decimal ; rdfs:label "fixed_charge"@es ; rdfs:comment "aka cuotaFija"@es .
cal:tariff_surcharges a owl:DatatypeProperty ; rdfs:domain cal:Tariff ; rdfs:range xsd:string ; rdfs:label "surcharges"@es ; rdfs:comment "e.g. {sewerage_pct: 10, sanitation_pct: 12} applied over the water amount"@es .
cal:tariff_vat_pct a owl:DatatypeProperty ; rdfs:domain cal:Tariff ; rdfs:range xsd:decimal ; rdfs:label "vat_pct"@es ; rdfs:comment "aka ivaPct; 0/exempt for domestic use"@es .
cal:tariff_currency a owl:DatatypeProperty ; rdfs:domain cal:Tariff ; rdfs:range xsd:string ; rdfs:label "currency"@es ; rdfs:comment "ISO 4217, MXN default"@es .
cal:tariff_valid_from a owl:DatatypeProperty ; rdfs:domain cal:Tariff ; rdfs:range xsd:date ; rdfs:label "valid_from"@es ; rdfs:comment "requerido · aka vigenciaDesde"@es .
cal:tariff_valid_to a owl:DatatypeProperty ; rdfs:domain cal:Tariff ; rdfs:range xsd:date ; rdfs:label "valid_to"@es ; rdfs:comment "aka vigenciaHasta"@es .
cal:tariff_version a owl:DatatypeProperty ; rdfs:domain cal:Tariff ; rdfs:range xsd:integer ; rdfs:label "version"@es .

### Clase bill
cal:Bill a owl:Class ; rdfs:label "Bill (header)"@es ; rdfs:comment "Billing document header per agreement-period: totals, due date, fiscal stamp and balances (merges Hydra Timbrado + Recibo; aka recibo, factura, CFDI 4.0). Lines live in bill_line."@es ; skos:note "clave: id"@es .
cal:bill_id a owl:DatatypeProperty ; rdfs:domain cal:Bill ; rdfs:range xsd:string ; rdfs:label "id"@es ; rdfs:comment "requerido"@es .
cal:bill_agreement_id a owl:ObjectProperty ; rdfs:domain cal:Bill ; rdfs:range cal:ServiceAgreement ; rdfs:label "agreement_id"@es ; rdfs:comment "requerido"@es .
cal:bill_period a owl:DatatypeProperty ; rdfs:domain cal:Bill ; rdfs:range xsd:string ; rdfs:label "period"@es ; rdfs:comment "requerido"@es .
cal:bill_consumption_id a owl:ObjectProperty ; rdfs:domain cal:Bill ; rdfs:range cal:Consumption ; rdfs:label "consumption_id"@es .
cal:bill_subtotal a owl:DatatypeProperty ; rdfs:domain cal:Bill ; rdfs:range xsd:decimal ; rdfs:label "subtotal"@es ; rdfs:comment "requerido"@es .
cal:bill_tax a owl:DatatypeProperty ; rdfs:domain cal:Bill ; rdfs:range xsd:decimal ; rdfs:label "tax"@es ; rdfs:comment "requerido · IVA; aka iva"@es .
cal:bill_total a owl:DatatypeProperty ; rdfs:domain cal:Bill ; rdfs:range xsd:decimal ; rdfs:label "total"@es ; rdfs:comment "requerido"@es .
cal:bill_currency a owl:DatatypeProperty ; rdfs:domain cal:Bill ; rdfs:range xsd:string ; rdfs:label "currency"@es ; rdfs:comment "MXN default"@es .
cal:bill_current_balance a owl:DatatypeProperty ; rdfs:domain cal:Bill ; rdfs:range xsd:decimal ; rdfs:label "current_balance"@es ; rdfs:comment "aka saldoVigente"@es .
cal:bill_overdue_balance a owl:DatatypeProperty ; rdfs:domain cal:Bill ; rdfs:range xsd:decimal ; rdfs:label "overdue_balance"@es ; rdfs:comment "aka saldoVencido"@es .
cal:bill_issued_at a owl:DatatypeProperty ; rdfs:domain cal:Bill ; rdfs:range xsd:date ; rdfs:label "issued_at"@es ; rdfs:comment "aka fechaEmision (String in Hydra — normalize)"@es .
cal:bill_due_at a owl:DatatypeProperty ; rdfs:domain cal:Bill ; rdfs:range xsd:date ; rdfs:label "due_at"@es ; rdfs:comment "aka fechaVencimiento"@es .
cal:bill_cfdi_uuid a owl:DatatypeProperty ; rdfs:domain cal:Bill ; rdfs:range xsd:string ; rdfs:label "cfdi_uuid"@es ; rdfs:comment "SAT fiscal UUID; aka Timbrado.uuid"@es .
cal:bill_stamp_status a owl:DatatypeProperty ; rdfs:domain cal:Bill ; rdfs:range xsd:string ; rdfs:label "stamp_status"@es ; rdfs:comment "valores: pending, stamped, pac_error, canceled · aka estado Timbrada OK/Error PAC/Pendiente"@es .
cal:bill_delivered a owl:DatatypeProperty ; rdfs:domain cal:Bill ; rdfs:range xsd:boolean ; rdfs:label "delivered"@es ; rdfs:comment "aka impreso (OM print/envelope pipeline)"@es .

### Clase bill_line
cal:BillLine a owl:Class ; rdfs:label "Bill line (concept)"@es ; rdfs:comment "Billed concept line (aka ContratoConcepto/ConceptoCobro, concepto de cobro; origin CONTRATACION/LECTURAS/VARIOS)."@es ; skos:note "clave: id"@es .
