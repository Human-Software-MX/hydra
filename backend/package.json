{
  "name": "contract-to-cash-flow-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "prisma migrate deploy && npx prisma db seed && node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "seed:demo-aquacis": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\"}' ts-node scripts/seed-demo-aquacis.ts",
    "import-sige-hydra": "ts-node --compiler-options {\"module\":\"CommonJS\"} scripts/import-sige-hydra.ts",
    "import:inegi-catalog": "ts-node --compiler-options {\"module\":\"CommonJS\"} scripts/import-inegi-catalog.ts",
    "import:localidades-sige-qro": "ts-node scripts/import-localidades-sige-qro.ts",
    "export:localidades-qro-json": "ts-node scripts/export-localidades-qro-json-from-ageeml.ts",
    "import:catalogos-tipos": "ts-node scripts/import-catalogos-tipos-contratacion.ts",
    "export:catalogos-tipos-sige-json": "ts-node scripts/export-catalogos-tipos-sige-json.ts",
    "import:distritos-punto-servicio": "ts-node --compiler-options {\"module\":\"CommonJS\"} scripts/import-distritos-punto-servicio.ts",
    "migrate:resolve-failed": "prisma migrate resolve --rolled-back \"20260302000000_add_sige_hydra\"",
    "migrate:fix-p3009": "prisma db execute --schema prisma/schema.prisma --file scripts/fix-failed-migration.sql && npm run migrate:resolve-failed && prisma migrate deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run verify:billing && npm run verify:cfdi && npm run verify:recibo && npm run verify:vee && npm run verify:balance",
    "verify:billing": "node -r ts-node/register/transpile-only scripts/verify-billing.ts",
    "verify:cfdi": "node -r ts-node/register/transpile-only scripts/verify-cfdi.ts",
    "verify:recibo": "node -r ts-node/register/transpile-only scripts/verify-recibo-html.ts",
    "verify:vee": "node -r ts-node/register/transpile-only scripts/verify-vee.ts",
    "verify:balance": "node -r ts-node/register/transpile-only scripts/verify-balance.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/client": "^6.8.2",
    "@types/multer": "^2.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "prisma": "^6.8.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "xlsx": "^0.18.5"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
