# ── Procesos batch (cron) ────────────────────────────────────────────
# Master switch: los jobs no corren si no está en true
HYDRA_JOBS_ENABLED=false
JOB_FACTURACION_CRON=0 2 1 * *
JOB_TIMBRADO_CRON=0 4 1 * *
JOB_VENCIMIENTOS_CRON=0 9 * * *
JOB_VENCIMIENTO_DIAS=3
# Reversa automática de restricciones al regularizar pago/convenio (mínimo vital LGA)
JOB_REVERSAS_CRON=0 10 * * *