DATABASE_URL="postgres://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5433/hydra?sslmode=require"

# Optional: port for the API (default 3001)
PORT=3001

# Allowed CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:8080

# JWT secret for access tokens — REQUIRED, the API refuses to boot without it.
# Generate one with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# Service-to-service token for the SIGE Hydra endpoint (min. 16 chars).
# Generate one with: openssl rand -base64 48
SIGE_HYDRA_API_TOKEN=CHANGE_ME

# Primer administrador de una instalación nueva — sólo los lee
# `npm run bootstrap:admin` (script de una sola vez, idempotente).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=CHANGE_ME
# ADMIN_NOMBRE=Administrador

INEGI_LOCALIDADES_URL=
SEPOMEX_XLSX_URL=
INEGI_LOCALIDADES_DOWNLOAD_EXT=.csv
SEPOMEX_DOWNLOAD_EXT=.xlsx
FEATURE_FACTURACION_CONTRATACION=true
